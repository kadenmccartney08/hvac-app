# --- Server ---
PORT=3000
NODE_ENV=development

# Public URL Twilio can reach this server at (needed for signature validation).
# Local dev: point this at your ngrok/tunnel URL, e.g. https://abcd1234.ngrok-free.app
# Production: your Railway/Render URL, e.g. https://hvac-app.up.railway.app
PUBLIC_BASE_URL=https://your-app.example.com

# --- Database (Postgres) ---
# Railway/Render both provision this automatically and inject DATABASE_URL for you.
DATABASE_URL=postgres://user:password@localhost:5432/hvac_app

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Set to false only for local testing when requests aren't actually coming from Twilio.
TWILIO_VALIDATE_SIGNATURE=true

# --- Business hours used to generate callback time slots ---
DEFAULT_BUSINESS_TIMEZONE=America/Chicago
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=17
